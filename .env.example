# 文件说明：CherryStudio agent 接口相关环境变量示例。
# Leave the URL empty to keep the UI in local empty-data mode.
#
# Optional. Leave empty to use the Vite local upload endpoint.
VITE_RECONCILIATION_UPLOAD_URL=
# CherryStudio local API. The frontend resolves an Agent and its only session at runtime.
VITE_CHERRYSTUDIO_BASE_URL=http://127.0.0.1:24333
VITE_CHERRYSTUDIO_API_KEY=
VITE_CHERRYSTUDIO_DEFAULT_AGENT_NAME=锐力体育
VITE_CHERRYSTUDIO_DEFAULT_AGENT_WORKSPACE=
