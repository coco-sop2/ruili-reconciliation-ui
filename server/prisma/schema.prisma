// 锐力对账系统数据库模型
// PostgreSQL 持久化模型：任务、审核明细与原始文件。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  NEEDS_REVIEW
  REVIEWED
  FAILED
  OBSOLETE
}

enum ReviewItemStatus {
  PENDING
  APPROVED
  IGNORED
}

enum FileKind {
  SETTLEMENT
  ERP
}

model ReconciliationTask {
  id               String        @id @default(uuid())
  version          Int           @default(1)
  status           TaskStatus
  period           String?
  periodRaw        String?
  settlementFileId String        @unique
  erpFileId        String        @unique

  settlementAmount Decimal?      @db.Decimal(14, 2)
  erpAmount        Decimal?      @db.Decimal(14, 2)
  differenceAmount Decimal?      @db.Decimal(14, 2)

  failureCode      String?
  failureMessage   String?

  agentName        String?
  agentWorkspace   String?
  agentId          String?
  agentSessionId   String?
  attemptCount     Int           @default(0)

  rawAgentPayload  Json?

  createdByName    String?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  resolvedAt       DateTime?

  settlementFile   File          @relation("SettlementFile", fields: [settlementFileId], references: [id], onDelete: Restrict)
  erpFile          File          @relation("ErpFile", fields: [erpFileId], references: [id], onDelete: Restrict)
  reviewItems      ReconciliationReviewItem[]

  @@unique([period, version])
  @@index([status])
  @@index([period])
  @@index([createdAt])
  @@map("reconciliation_tasks")
}

model ReconciliationReviewItem {
  id               String           @id @default(uuid())
  taskId           String
  task             ReconciliationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  label            String
  differenceAmount Decimal?         @db.Decimal(14, 2)
  status           ReviewItemStatus @default(PENDING)
  payload          Json

  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  @@index([taskId])
  @@map("reconciliation_review_items")
}

model File {
  id           String   @id @default(uuid())
  kind         FileKind
  originalName String
  contentType  String?
  sizeBytes    BigInt
  storedPath   String

  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  settlementTask ReconciliationTask? @relation("SettlementFile")
  erpTask        ReconciliationTask? @relation("ErpFile")

  @@map("files")
}
